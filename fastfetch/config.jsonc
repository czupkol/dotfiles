{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
    	"source": "~/.config/fastfetch/fugue-icon.png",
    	"type": "kitty-direct",
    	"height": 17,
	"width": 38,
    	"padding": {
    		"top": 2
    	}
    },
    "display": {
        "separator": " "
    },
    "modules": [
	{
            "type": "custom",
            "format": "\u001b[90m  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m "
        },
	"break",
	{
            "type": "custom",
            "format": "\u001b[35mellie\u001b[37m@\u001b[35mhajpergurl"
        },
        "break",
        {
            "type": "os",
            "key": " ",
            "keyColor": "31",  // = color4
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "31",
        },
        {
            "type": "packages",
            "format": "{} (pacman)",
            "key": " ",
            "keyColor": "31",  
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "31", 
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "31", 
        },
        {
            "type": "wm",
            "key": " ",
            "keyColor": "31", 
        },
        {
            "type": "display",
            "key": " ",
            "keyColor": "31"
        },
        {
            "type": "cpu",
            "format": "{1}",
            "key": " ",
            "keyColor": "31"
        },
        {
            "type": "gpu",
            "format": "{2}",
            "key": " ",
            "keyColor": "31"
        },
        {
             "type": "memory",
            "key": "󰍛 ",
            "keyColor": "31"
        },
        {
             "type": "swap",
            "key": "󰾴 ",
            "keyColor": "31"
        },
        {
            "type": "disk",
            "key": " ",
            "keyColor": "31"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m "
        },
        "break",
        "break",
    ]
}
